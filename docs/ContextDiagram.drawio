<mxfile host="app.diagrams.net" type="device"><diagram id="context-diagram" name="System Context Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ccs_proc" parent="1" value="&lt;b&gt;CHILDREN CARE SYSTEM (CCS)&lt;/b&gt;&lt;br/&gt;(Hệ Thống Trung Tâm Y Tế Nhi Khoa)&lt;br/&gt;&lt;i&gt;ASP.NET Core 8.0 MVC&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;fontColor=#003366;shadow=1;" vertex="1"><mxGeometry x="580" y="360" width="240" height="240" as="geometry" /></mxCell><mxCell id="act_guest" parent="1" value="Khách vãng lai&lt;br/&gt;(Guest)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1"><mxGeometry x="140" y="140" width="60" height="100" as="geometry" /></mxCell><mxCell id="act_cust" parent="1" value="Khách hàng / Phụ huynh&lt;br/&gt;(Customer)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1"><mxGeometry x="140" y="420" width="60" height="100" as="geometry" /></mxCell><mxCell id="act_manager" parent="1" value="Quản lý trung tâm&lt;br/&gt;(Manager)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1"><mxGeometry x="140" y="700" width="60" height="100" as="geometry" /></mxCell><mxCell id="act_staff" parent="1" value="Nhân sự y tế&lt;br/&gt;(Staff: Bác sĩ &amp; Y tá)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1"><mxGeometry x="1200" y="260" width="60" height="100" as="geometry" /></mxCell><mxCell id="act_admin" parent="1" value="Quản trị viên&lt;br/&gt;(Admin)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1"><mxGeometry x="1200" y="620" width="60" height="100" as="geometry" /></mxCell><mxCell id="ext_smtp" parent="1" value="Hệ Thống Email Ngoại Vi&lt;br/&gt;&lt;b&gt;Gmail SMTP Server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;fontColor=#663300;shadow=1;" vertex="1"><mxGeometry x="610" y="80" width="180" height="70" as="geometry" /></mxCell><mxCell id="ext_vnpay" parent="1" value="Cổng Thanh Toán Trực Tuyến&lt;br/&gt;&lt;b&gt;VNPay Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;fontColor=#663300;shadow=1;" vertex="1"><mxGeometry x="610" y="780" width="180" height="70" as="geometry" /></mxCell><mxCell id="e_g_in" parent="1" value="1. Tìm dịch vụ/bài viết, gửi liên hệ&lt;br/&gt;2. Đăng ký, đặt hẹn tạm thời" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="act_guest" target="ccs_proc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_g_out" parent="1" value="Trang chủ, chi tiết gói khám, cẩm nang y tế" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ccs_proc" target="act_guest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_c_in" parent="1" value="Đăng nhập, đặt hẹn khám, hủy lịch (Submitted),&lt;br/&gt;gửi phản hồi/feedback, thanh toán cọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="act_cust" target="ccs_proc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_c_out" parent="1" value="Danh sách lịch hẹn của tôi, lịch sử khám,&lt;br/&gt;kết luận chẩn đoán &amp; đơn thuốc của trẻ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ccs_proc" target="act_cust"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_s_in" parent="1" value="Cập nhật trạng thái khám (Check-in/Khám xong),&lt;br/&gt;ghi chẩn đoán, kê đơn thuốc (Doctor)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="act_staff" target="ccs_proc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_s_out" parent="1" value="Lịch hẹn phân công, thông tin bệnh nhi, bệnh sử" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ccs_proc" target="act_staff"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_m_in" parent="1" value="Quản lý dịch vụ, bài viết, banner, phân công ca khám" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="act_manager" target="ccs_proc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_m_out" parent="1" value="Reservation Dashboard (doanh thu, lượt khám), phản hồi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ccs_proc" target="act_manager"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a_in" parent="1" value="Quản lý người dùng, phân vai trò, cấu hình Settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="act_admin" target="ccs_proc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a_out" parent="1" value="Admin Dashboard, danh sách tài khoản &amp; cấu hình" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ccs_proc" target="act_admin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_smtp_send" parent="1" value="Lệnh gửi mail kích hoạt, reset MK, nhắc lịch khám" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ccs_proc" target="ext_smtp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_smtp_res" parent="1" value="Trạng thái gửi mail (Success/Fail)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ext_smtp" target="ccs_proc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_pay_req" parent="1" value="Yêu cầu tạo phiên thanh toán (OrderCode, Amount)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ccs_proc" target="ext_vnpay"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_pay_res" parent="1" value="Kết quả giao dịch (IPN Callback: Paid/Failed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;" edge="1" source="ext_vnpay" target="ccs_proc"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>