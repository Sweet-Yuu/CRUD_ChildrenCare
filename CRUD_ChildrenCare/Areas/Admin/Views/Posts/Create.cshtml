@using CRUD_ChildrenCare.Models.Enums
@model CRUD_ChildrenCare.Areas.Admin.ViewModels.Posts.PostFormViewModel
@{ ViewData["Title"] = "Create Post"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Create Post</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Select Category...</option>
                        @foreach (var cat in Model.Categories) { <option value="@cat.Id">@cat.Name</option> }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Thumbnail" class="form-label">Thumbnail URL</label>
                <input asp-for="Thumbnail" class="form-control" />
                <span asp-validation-for="Thumbnail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BriefInfo" class="form-label">Brief Info</label>
                <textarea asp-for="BriefInfo" class="form-control" rows="2"></textarea>
                <span asp-validation-for="BriefInfo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Content (HTML)</label>
                <textarea asp-for="Description" class="form-control" rows="10"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label">Featured Post</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label me-2">Status:</label>
                    <select asp-for="Status" class="form-select d-inline-block w-auto">
                        @foreach (var s in Enum.GetValues<PostStatus>()) { <option value="@s">@s</option> }
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-primary px-4">Create</button>
        </form>
    </div>
</div>
