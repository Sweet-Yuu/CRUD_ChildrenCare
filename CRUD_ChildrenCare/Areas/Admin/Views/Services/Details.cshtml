@model CRUD_ChildrenCare.Models.Service
@{
    ViewData["Title"] = "Service Details - " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Service Details (Read-Only)</h2>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-info text-dark py-3">
                <h4 class="mb-0 fw-bold">@Model.Title</h4>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-4 text-center">
                        <img src="@(string.IsNullOrWhiteSpace(Model.Thumbnail) ? "/images/default-service.jpg" : Model.Thumbnail)" class="img-fluid rounded border shadow-sm" style="max-height: 250px; object-fit: cover;" alt="@Model.Title">
                    </div>
                    <div class="col-md-8">
                        <div class="table-responsive">
                            <table class="table table-borderless">
                                <tr>
                                    <th style="width: 30%;">Category:</th>
                                    <td><span class="badge bg-info text-dark fs-6">@Model.Category?.Name</span></td>
                                </tr>
                                <tr>
                                    <th>List Price:</th>
                                    <td>@Model.ListPrice.ToString("N0") VND</td>
                                </tr>
                                <tr>
                                    <th>Sale Price:</th>
                                    <td class="text-primary fw-bold fs-5">@Model.SalePrice.ToString("N0") VND</td>
                                </tr>
                                <tr>
                                    <th>Target Persons:</th>
                                    <td>@Model.NumberOfPerson Person(s)</td>
                                </tr>
                                <tr>
                                    <th>Available Quantity:</th>
                                    <td><span class="badge bg-success">@Model.AvailableQuantity Slots</span></td>
                                </tr>
                                <tr>
                                    <th>Featured:</th>
                                    <td>
                                        @if (Model.IsFeatured) { <span class="badge bg-warning text-dark">Yes</span> }
                                        else { <span class="badge bg-secondary">No</span> }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Status:</th>
                                    <td>
                                        @if (Model.Status == CRUD_ChildrenCare.Models.Enums.ServiceStatus.Active) { <span class="badge bg-success">Active</span> }
                                        else { <span class="badge bg-secondary">Inactive</span> }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Created / Updated:</th>
                                    <td class="small text-muted">@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm") / @Model.UpdatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="mb-4">
                    <h5 class="fw-bold">Brief Info</h5>
                    <p class="text-muted">@Model.BriefInfo</p>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold">Full Description</h5>
                    <div class="p-3 bg-light rounded border">
                        @Html.Raw(Model.Description)
                    </div>
                </div>

                @if (Model.ServiceImages != null && Model.ServiceImages.Any())
                {
                    <div>
                        <h5 class="fw-bold mb-3">Gallery Images</h5>
                        <div class="row g-3">
                            @foreach (var img in Model.ServiceImages)
                            {
                                <div class="col-md-3 col-6">
                                    <img src="@img.ImageUrl" class="img-fluid rounded border shadow-sm" style="height: 120px; width: 100%; object-fit: cover;" alt="Gallery" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
