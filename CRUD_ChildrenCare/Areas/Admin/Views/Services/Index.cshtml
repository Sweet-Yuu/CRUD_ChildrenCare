@using CRUD_ChildrenCare.Models.Enums
@model CRUD_ChildrenCare.Areas.Admin.ViewModels.Services.ServiceListAdminViewModel
@{
    ViewData["Title"] = "Manage Services";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Services</h2>
    @if (Model.CanManage)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Create New Service</a>
    }
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control" placeholder="Search title or info..." value="@Model.SearchQuery">
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.CategoryId == cat.Id) { <option value="@cat.Id" selected>@cat.Name</option> }
                        else { <option value="@cat.Id">@cat.Name</option> }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<ServiceStatus>())
                    {
                        if (Model.Status == s.ToString()) { <option value="@s" selected>@s</option> }
                        else { <option value="@s">@s</option> }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="sort" class="form-select">
                    <option value="">Sort by...</option>
                    @foreach (var sort in new[] { "Title", "TitleDesc", "Category", "ListPrice", "ListPriceDesc", "SalePrice", "SalePriceDesc", "Featured", "Status" })
                    {
                        if (Model.Sort == sort) { <option value="@sort" selected>@sort</option> }
                        else { <option value="@sort">@sort</option> }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Thumbnail</th>
                <th>Title</th>
                <th>Category</th>
                <th>List Price</th>
                <th>Sale Price</th>
                <th>Featured</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Services.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No services found.</td>
                </tr>
            }
            else
            {
                @foreach (var service in Model.Services)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrWhiteSpace(service.Thumbnail) ? "/images/default-service.jpg" : service.Thumbnail)" width="50" height="50" style="object-fit:cover;" class="rounded border" alt="@service.Title" />
                        </td>
                        <td class="fw-bold">@service.Title</td>
                        <td><span class="badge bg-info text-dark">@service.Category?.Name</span></td>
                        <td>@service.ListPrice.ToString("N0") VND</td>
                        <td class="text-primary fw-bold">@service.SalePrice.ToString("N0") VND</td>
                        <td>
                            @if (service.IsFeatured) { <span class="badge bg-warning text-dark">Yes</span> }
                            else { <span class="badge bg-secondary">No</span> }
                        </td>
                        <td>
                            @if (service.Status == ServiceStatus.Active) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@service.Id" class="btn btn-sm btn-outline-info">View</a>
                            @if (Model.CanManage)
                            {
                                <a asp-action="Edit" asp-route-id="@service.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                                <form asp-action="ToggleStatus" asp-route-id="@service.Id" method="post" class="d-inline ms-1">
                                    <button type="submit" class="btn btn-sm @(service.Status == ServiceStatus.Active ? "btn-outline-danger" : "btn-outline-success")">
                                        @(service.Status == ServiceStatus.Active ? "Hide" : "Show")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@(Model.PageIndex - 1)">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@(Model.PageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
