@model ReservationDetailsAdminViewModel
@{
    ViewData["Title"] = $"Reservation #{Model.Reservation.Id} Details";
    var r = Model.Reservation;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        &larr; Back to Reservations List
    </a>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-1">
                Reservation #@r.Id
                @switch (r.Status)
                {
                    case ReservationStatus.Success:
                        <span class="badge bg-success fs-6 align-middle ms-2">Success</span>
                        break;
                    case ReservationStatus.Submitted:
                        <span class="badge bg-warning text-dark fs-6 align-middle ms-2">Submitted</span>
                        break;
                    case ReservationStatus.Cancelled:
                        <span class="badge bg-secondary fs-6 align-middle ms-2">Cancelled</span>
                        break;
                    default:
                        <span class="badge bg-info fs-6 align-middle ms-2">@r.Status</span>
                        break;
                }
            </h2>
            <small class="text-muted">
                Booked on @r.ReservedDate.ToString("dd/MM/yyyy HH:mm") | Last updated: @r.UpdatedDate.ToString("dd/MM/yyyy HH:mm")
            </small>
        </div>

        <div class="d-flex gap-2">
            @if (Model.CanComplete && r.Status == ReservationStatus.Submitted)
            {
                <form asp-action="UpdateStatusAndStaff" asp-route-id="@r.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="status" value="@ReservationStatus.Success" />
                    <input type="hidden" name="staffId" value="@r.AssignedStaffId" />
                    <button type="submit" class="btn btn-success" onclick="return confirm('Confirm completing this checkup reservation?');">
                        &check; Mark as Completed (Success)
                    </button>
                </form>
            }

            @if (Model.CanManage)
            {
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-primary">
                    Edit Reservation
                </a>

                @if (r.Status == ReservationStatus.Submitted)
                {
                    <form asp-action="Cancel" asp-route-id="@r.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this reservation? Service quantities will be restored.');">
                            Cancel Reservation
                        </button>
                    </form>
                }
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Receiver & Appointment Info -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0">Customer &amp; Appointment Information</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Full Name</dt>
                    <dd class="col-sm-8 fw-semibold">@r.ReceiverFullName</dd>

                    <dt class="col-sm-4 text-muted">Gender</dt>
                    <dd class="col-sm-8">@r.ReceiverGender</dd>

                    <dt class="col-sm-4 text-muted">Mobile Phone</dt>
                    <dd class="col-sm-8">
                        <a href="tel:@r.ReceiverMobile" class="text-decoration-none">@r.ReceiverMobile</a>
                    </dd>

                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">
                        <a href="mailto:@r.ReceiverEmail" class="text-decoration-none">@r.ReceiverEmail</a>
                    </dd>

                    <dt class="col-sm-4 text-muted">Address</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(r.ReceiverAddress) ? "N/A" : r.ReceiverAddress)</dd>

                    <hr class="my-3" />

                    <dt class="col-sm-4 text-muted">Checkup Time</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary fs-6">
                            📅 @r.CheckupTime.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted">User Account</dt>
                    <dd class="col-sm-8">
                        @if (r.User != null)
                        {
                            <span>@r.User.FullName (@r.User.Email)</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Guest Customer (No Account)</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Notes</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrWhiteSpace(r.Notes))
                        {
                            <span class="text-muted fst-italic">No special notes</span>
                        }
                        else
                        {
                            <div class="p-2 bg-light rounded small">@r.Notes</div>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Right Column: Assigned Staff & Status Management -->
    <div class="col-lg-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0">Assigned Medical Staff</h5>
            </div>
            <div class="card-body">
                @if (r.AssignedStaff != null)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.3rem;">
                            🩺
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">@r.AssignedStaff.FullName</h6>
                            <small class="text-muted">@r.AssignedStaff.Email | @r.AssignedStaff.Mobile</small>
                            <div><span class="badge bg-info mt-1">@r.AssignedStaff.Role?.Name</span></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        No medical staff is currently assigned to this reservation.
                    </div>
                }

                @if (Model.CanManage)
                {
                    <hr class="my-3" />
                    <form asp-action="UpdateStatusAndStaff" asp-route-id="@r.Id" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <h6 class="fw-semibold mb-3">Quick Reassign / Update Status</h6>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Status</label>
                            <select name="status" class="form-select">
                                @foreach (var st in Enum.GetValues<ReservationStatus>())
                                {
                                    if (st == ReservationStatus.Cart) continue;
                                    <option value="@st" selected="@(r.Status == st)">@st</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Reassign Staff (Doctor / Nurse)</label>
                            <select name="staffId" class="form-select">
                                <option value="">-- Select Staff --</option>
                                @foreach (var staff in Model.Staffs)
                                {
                                    <option value="@staff.Id" selected="@(r.AssignedStaffId == staff.Id)">
                                        @staff.FullName (@staff.Role?.Name)
                                    </option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            Save Quick Updates
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<!-- Booked Services Table -->
<div class="card shadow-sm mt-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Booked Health Services</h5>
        <span class="text-muted small">@r.ReservationItems.Count item(s)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Service Title</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-center">No. of Persons</th>
                        <th class="text-end">Total Price</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var index = 1; }
                    @foreach (var item in r.ReservationItems)
                    {
                        <tr>
                            <td>@(index++)</td>
                            <td>
                                <div class="fw-semibold">@(item.Service?.Title ?? "Service #" + item.ServiceId)</div>
                                @if (!string.IsNullOrWhiteSpace(item.Service?.BriefInfo))
                                {
                                    <small class="text-muted">@item.Service.BriefInfo</small>
                                }
                            </td>
                            <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-center">@item.NumberOfPerson</td>
                            <td class="text-end fw-semibold">@item.TotalCost.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="text-end fw-bold fs-6">Grand Total:</td>
                        <td class="text-end fw-bold fs-5 text-primary">@r.TotalCost.ToString("N0") ₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
