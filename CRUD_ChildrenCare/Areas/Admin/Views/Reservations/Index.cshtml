@model ReservationListAdminViewModel
@{
    ViewData["Title"] = "Manage Reservations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Manage Reservations</h2>
        <p class="text-muted mb-0">
            @if (Model.IsStaffOnly)
            {
                <span>Viewing appointments assigned to you (@Model.CurrentRole)</span>
            }
            else
            {
                <span>Monitor and manage all clinic reservations, assignments, and statuses</span>
            }
        </p>
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" class="form-control" placeholder="ID, name, phone, email..." value="@Model.SearchQuery" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<ReservationStatus>())
                    {
                        if (s == ReservationStatus.Cart) continue;
                        if (Model.Status == s)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>

            @if (!Model.IsStaffOnly)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Assigned Staff</label>
                    <select name="staffId" class="form-select">
                        <option value="">All Staffs</option>
                        @foreach (var staff in Model.Staffs)
                        {
                            if (Model.StaffId == staff.Id)
                            {
                                <option value="@staff.Id" selected>@staff.FullName (@staff.Role?.Name)</option>
                            }
                            else
                            {
                                <option value="@staff.Id">@staff.FullName (@staff.Role?.Name)</option>
                            }
                        }
                    </select>
                </div>
            }

            <div class="col-md-3">
                <label class="form-label small fw-semibold">Sort By</label>
                <select name="sort" class="form-select">
                    <option value="">Default (Newest Booked)</option>
                    <option value="ReservedDateAsc" selected="@(Model.Sort == "ReservedDateAsc")">Booked Date (Oldest First)</option>
                    <option value="CheckupTime" selected="@(Model.Sort == "CheckupTime")">Checkup Time (Earliest First)</option>
                    <option value="CheckupTimeDesc" selected="@(Model.Sort == "CheckupTimeDesc")">Checkup Time (Latest First)</option>
                    <option value="Receiver" selected="@(Model.Sort == "Receiver")">Receiver Name (A-Z)</option>
                    <option value="ReceiverDesc" selected="@(Model.Sort == "ReceiverDesc")">Receiver Name (Z-A)</option>
                    <option value="TotalCost" selected="@(Model.Sort == "TotalCost")">Total Cost (Lowest)</option>
                    <option value="TotalCostDesc" selected="@(Model.Sort == "TotalCostDesc")">Total Cost (Highest)</option>
                    <option value="Status" selected="@(Model.Sort == "Status")">Status</option>
                </select>
            </div>

            <div class="col-md-@(Model.IsStaffOnly ? "3" : "2") d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Reservations List (@Model.TotalItems total)</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Reservations.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted mb-0">No reservations found matching your criteria.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Receiver / Customer</th>
                            <th>Booked Date</th>
                            <th>Checkup Time</th>
                            <th>Assigned Staff</th>
                            <th class="text-end">Total Cost</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Reservations)
                        {
                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td>
                                    <div class="fw-semibold">@item.ReceiverFullName</div>
                                    <small class="text-muted">@item.ReceiverMobile | @item.ReceiverEmail</small>
                                </td>
                                <td>@item.ReservedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        📅 @item.CheckupTime.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td>
                                    @if (item.AssignedStaff != null)
                                    {
                                        <span class="text-dark">@item.AssignedStaff.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Unassigned</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold text-primary">
                                    @item.TotalCost.ToString("N0") ₫
                                </td>
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case ReservationStatus.Success:
                                            <span class="badge bg-success">Success</span>
                                            break;
                                        case ReservationStatus.Submitted:
                                            <span class="badge bg-warning text-dark">Submitted</span>
                                            break;
                                        case ReservationStatus.Cancelled:
                                            <span class="badge bg-secondary">Cancelled</span>
                                            break;
                                        default:
                                            <span class="badge bg-info">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="View details">
                                            Details
                                        </a>
                                        @if (!Model.IsStaffOnly)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit status or staff">
                                                Edit
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="p-3 d-flex justify-content-between align-items-center border-top">
                    <small class="text-muted">Page @Model.PageIndex of @Model.TotalPages</small>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.PageIndex - 1)"
                                   asp-route-search="@Model.SearchQuery"
                                   asp-route-status="@Model.Status"
                                   asp-route-staffId="@Model.StaffId"
                                   asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-sort="@Model.Sort">Previous</a>
                            </li>

                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@p"
                                       asp-route-search="@Model.SearchQuery"
                                       asp-route-status="@Model.Status"
                                       asp-route-staffId="@Model.StaffId"
                                       asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                       asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                       asp-route-sort="@Model.Sort">@p</a>
                                </li>
                            }

                            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.PageIndex + 1)"
                                   asp-route-search="@Model.SearchQuery"
                                   asp-route-status="@Model.Status"
                                   asp-route-staffId="@Model.StaffId"
                                   asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-sort="@Model.Sort">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
