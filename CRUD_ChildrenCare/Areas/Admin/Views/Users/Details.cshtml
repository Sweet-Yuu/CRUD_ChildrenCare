@model UserDetailsViewModel
@{ ViewData["Title"] = "User details"; }
<div class="row justify-content-center"><div class="col-lg-9"><div class="d-flex justify-content-between align-items-center mb-4"><h1 class="mb-0">User details</h1><div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit access</a> <a class="btn btn-link" asp-action="Index">Back to users</a></div></div>
<div class="card shadow-sm"><div class="card-body p-4"><div class="row g-4"><div class="col-md-3 text-center">@if (!string.IsNullOrWhiteSpace(Model.AvatarUrl)) { <img src="@Model.AvatarUrl" class="img-fluid rounded-circle border" style="width: 150px; height: 150px; object-fit: cover;" alt="User avatar" /> } else { <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center text-muted" style="width: 150px; height: 150px;">No avatar</div> }</div><div class="col-md-9"><dl class="row mb-0">
<dt class="col-sm-4">Full name</dt><dd class="col-sm-8">@Model.FullName</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd><dt class="col-sm-4">Mobile</dt><dd class="col-sm-8">@Model.Mobile</dd><dt class="col-sm-4">Gender</dt><dd class="col-sm-8">@Model.Gender</dd><dt class="col-sm-4">Address</dt><dd class="col-sm-8">@(Model.Address ?? "Not provided")</dd><dt class="col-sm-4">Role</dt><dd class="col-sm-8">@Model.RoleName</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="badge @(Model.Status == UserStatus.Active ? "text-bg-success" : "text-bg-secondary")">@Model.Status</span></dd><dt class="col-sm-4">Created</dt><dd class="col-sm-8">@Model.CreatedDate.ToString("u")</dd>
</dl></div></div></div></div>
<form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Are you sure you want to @(Model.Status == UserStatus.Active ? "deactivate" : "reactivate") this account?');"><button class="btn @(Model.Status == UserStatus.Active ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(Model.Status == UserStatus.Active ? "Deactivate" : "Reactivate")</button></form>
</div></div>
