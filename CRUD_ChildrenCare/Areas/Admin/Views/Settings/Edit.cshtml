@model SettingFormViewModel
@{ ViewData["Title"] = "Edit setting"; }
<div class="row justify-content-center"><div class="col-lg-7">
    <h1>Edit setting</h1><p class="text-muted">Update setting details and availability.</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate><partial name="_Form" model="Model" /><button class="btn btn-primary" type="submit">Save changes</button><a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
