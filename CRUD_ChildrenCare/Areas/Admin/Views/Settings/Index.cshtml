@model SettingsIndexViewModel
@{
    ViewData["Title"] = "Settings";
    string NextDirection(string column) => Model.Sort.Equals(column, StringComparison.OrdinalIgnoreCase) && Model.Direction == "asc" ? "desc" : "asc";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="mb-1">Settings</h1><p class="text-muted mb-0">Manage application categories, roles, and menu definitions.</p></div>
    <a class="btn btn-primary" asp-action="Create">Create setting</a>
</div>
<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-5"><label class="form-label" for="search">Search</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Name, value, or description" /></div>
        <div class="col-md-3"><label class="form-label" for="type">Type</label><select class="form-select" id="type" name="type"><option value="">All types</option>@foreach (var value in Enum.GetValues<SettingType>()) { <option value="@value" selected="@(Model.Type == value)">@value</option> }</select></div>
        <div class="col-md-2"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><option value="">All statuses</option>@foreach (var value in Enum.GetValues<SettingStatus>()) { <option value="@value" selected="@(Model.Status == value)">@value</option> }</select></div>
        <div class="col-md-2 d-grid"><button class="btn btn-outline-primary" type="submit">Apply filters</button></div>
    </div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr>
            @foreach (var column in new[] { "Id", "Type", "Name", "Value", "Status" })
            {
                <th><a asp-action="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-sort="@column" asp-route-direction="@NextDirection(column)">@column</a></th>
            }
            <th class="text-end">Actions</th>
        </tr></thead>
        <tbody>
        @if (Model.Results.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No settings found.</td></tr>
        }
        else
        {
            @foreach (var item in Model.Results.Items)
            {
                <tr data-setting-row>
                    <td>@item.Id</td><td>@item.Type</td><td>@item.Name</td><td>@item.Value</td>
                    <td><span class="badge @(item.Status == SettingStatus.Active ? "text-bg-success" : "text-bg-secondary")">@item.Status</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
@if (Model.Results.TotalPages > 1)
{
    <nav aria-label="Settings pages"><ul class="pagination justify-content-center">
        <li class="page-item @(!Model.Results.HasPreviousPage ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction" asp-route-page="@(Model.Results.Page - 1)">Previous</a></li>
        @for (var pageNumber = 1; pageNumber <= Model.Results.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.Results.Page ? "active" : null)"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction" asp-route-page="@pageNumber">@pageNumber</a></li>
        }
        <li class="page-item @(!Model.Results.HasNextPage ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction" asp-route-page="@(Model.Results.Page + 1)">Next</a></li>
    </ul></nav>
}
