@model SettingDetailsViewModel
@{ ViewData["Title"] = "Setting details"; }
<div class="row justify-content-center"><div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-4"><h1 class="mb-0">Setting details</h1><div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a class="btn btn-link" asp-action="Index">Back to settings</a></div></div>
    <div class="card shadow-sm"><div class="card-body p-4"><dl class="row mb-0">
        <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.Id</dd><dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.Type</dd><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Value</dt><dd class="col-sm-9">@Model.Value</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9">@(Model.Description ?? "Not provided")</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge @(Model.Status == SettingStatus.Active ? "text-bg-success" : "text-bg-secondary")">@Model.Status</span></dd>
    </dl></div></div>
    <form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Are you sure you want to @(Model.Status == SettingStatus.Active ? "deactivate" : "reactivate") this setting?');"><button class="btn @(Model.Status == SettingStatus.Active ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(Model.Status == SettingStatus.Active ? "Deactivate" : "Reactivate")</button></form>
</div></div>
