@model SettingFormViewModel
@{ ViewData["Title"] = "Create setting"; }
<div class="row justify-content-center"><div class="col-lg-7">
    <h1>Create setting</h1><p class="text-muted">Add a new application setting.</p>
    <form asp-action="Create" method="post" novalidate><partial name="_Form" model="Model" /><button class="btn btn-primary" type="submit">Create setting</button><a class="btn btn-link" asp-action="Index">Cancel</a></form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
