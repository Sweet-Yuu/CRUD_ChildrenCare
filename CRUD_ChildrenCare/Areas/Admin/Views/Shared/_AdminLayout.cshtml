<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - Children Care Administration</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body class="admin-body"><div class="admin-shell">
    <aside class="admin-sidebar"><a class="admin-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark">+</span><span>Children Care<small>Administration</small></span></a><div class="admin-navigation">@await Component.InvokeAsync("AdminMenu")</div><a class="admin-home-link" asp-area="" asp-controller="Home" asp-action="Index">Back to public site</a></aside>
    <div class="admin-content"><header class="admin-header"><button class="btn btn-sm btn-outline-secondary admin-menu-toggle" type="button" data-admin-menu-toggle aria-label="Toggle administration menu">Menu</button><span class="text-muted ms-auto">@User.Identity?.Name</span><a class="btn btn-sm btn-outline-primary" asp-area="" asp-controller="Profile" asp-action="Index">My profile</a><form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Sign out</button></form></header>
    <main class="admin-main">@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success" role="alert">@successMessage</div> } @RenderBody()</main></div>
</div><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
