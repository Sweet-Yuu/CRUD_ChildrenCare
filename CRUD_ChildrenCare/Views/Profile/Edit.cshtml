@model CRUD_ChildrenCare.ViewModels.Profile.EditProfileViewModel
@{
    ViewData["Title"] = "Edit profile";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1>Edit profile</h1>
        <p class="text-muted">Update your personal information and profile image.</p>
        <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" readonly />
                <div class="form-text">Email cannot be changed here.</div>
            </div>
            <div class="row">
                <div class="col-md-8 mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                <div class="col-md-4 mb-3"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select"></select><span asp-validation-for="Gender" class="text-danger"></span></div>
            </div>
            <div class="mb-3"><label asp-for="Mobile" class="form-label"></label><input asp-for="Mobile" class="form-control" /><span asp-validation-for="Mobile" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger"></span></div>
            <div class="mb-3">
                <label asp-for="Avatar" class="form-label"></label>
                <input asp-for="Avatar" class="form-control" accept="image/jpeg,image/png,image/webp" />
                <div class="form-text">JPG, PNG, or WebP; maximum 2 MB.</div>
                <span asp-validation-for="Avatar" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
