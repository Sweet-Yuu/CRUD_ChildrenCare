@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<div class="row justify-content-center"><div class="col-md-6 col-lg-5">
    <h1>Reset password</h1>
    <form asp-action="ResetPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" />
        <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button class="btn btn-primary w-100" type="submit">Reset password</button>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
