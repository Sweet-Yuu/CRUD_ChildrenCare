@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="row justify-content-center"><div class="col-md-6 col-lg-5">
    <h1>Sign in</h1>
    <p class="text-muted">Access your Children Care account.</p>
    <form asp-action="Login" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <button class="btn btn-primary w-100" type="submit">Sign in</button>
    </form>
    <div class="mt-3 d-flex justify-content-between"><a asp-action="ForgotPassword">Forgot password?</a><a asp-action="Register">Create account</a></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
