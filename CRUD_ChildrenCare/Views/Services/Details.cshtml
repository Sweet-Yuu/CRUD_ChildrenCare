@model CRUD_ChildrenCare.ViewModels.Services.ServiceDetailPublicViewModel
@{
    ViewData["Title"] = Model.Service.Title;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Services</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Service.Title</li>
        </ol>
    </nav>

    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-3">
                <img id="mainImage" src="@(string.IsNullOrWhiteSpace(Model.Service.Thumbnail) ? "/images/default-service.jpg" : Model.Service.Thumbnail)" class="img-fluid w-100" style="max-height: 400px; object-fit: cover;" alt="@Model.Service.Title">
            </div>

            @if (Model.GalleryImages.Any())
            {
                <div class="row g-2">
                    <div class="col-3">
                        <img src="@Model.Service.Thumbnail" class="img-thumbnail cursor-pointer opacity-75 hover-opacity-100" style="height: 80px; width: 100%; object-fit: cover;" onclick="document.getElementById('mainImage').src = this.src" alt="Thumbnail">
                    </div>
                    @foreach (var img in Model.GalleryImages)
                    {
                        <div class="col-3">
                            <img src="@img.ImageUrl" class="img-thumbnail cursor-pointer opacity-75 hover-opacity-100" style="height: 80px; width: 100%; object-fit: cover;" onclick="document.getElementById('mainImage').src = this.src" alt="Gallery Image">
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-6">
            <span class="badge bg-primary fs-6 mb-2">@Model.Service.Category?.Name</span>
            @if (Model.Service.IsFeatured)
            {
                <span class="badge bg-warning text-dark fs-6 mb-2 ms-1">Featured</span>
            }
            <h1 class="display-6 fw-bold mb-3">@Model.Service.Title</h1>

            <div class="p-3 bg-light rounded-3 mb-4">
                <div class="d-flex align-items-baseline mb-1">
                    <span class="display-6 fw-bold text-primary me-3">@Model.Service.SalePrice.ToString("N0") VND</span>
                    @if (Model.Service.ListPrice > Model.Service.SalePrice)
                    {
                        <span class="fs-5 text-decoration-line-through text-muted">@Model.Service.ListPrice.ToString("N0") VND</span>
                    }
                </div>
                <div class="text-muted small">
                    <i class="bi bi-check-circle-fill text-success me-1"></i> Inclusive of initial consultation & checkup
                </div>
            </div>

            <div class="mb-4">
                <div class="row text-center g-2">
                    <div class="col-6">
                        <div class="p-2 border rounded">
                            <small class="text-muted d-block">Target Audience</small>
                            <strong>@Model.Service.NumberOfPerson Person(s)</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded">
                            <small class="text-muted d-block">Available Slots</small>
                            <strong class="text-success">@Model.Service.AvailableQuantity Slots</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold">Overview</h5>
                <p class="text-muted">@Model.Service.BriefInfo</p>
            </div>

            <div class="d-flex gap-3">
                <form asp-controller="Reservation" asp-action="AddToCart" method="post" class="flex-fill">
                    <input type="hidden" name="serviceId" value="@Model.Service.Id" />
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-cart-plus me-2"></i> Add to Cart
                    </button>
                </form>
                <a href="#feedback" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-chat-square-text me-2"></i> Feedback
                </a>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4">
                <h4 class="fw-bold border-bottom pb-3 mb-3">Detailed Description</h4>
                <div class="service-description">
                    @Html.Raw(Model.Service.Description)
                </div>
            </div>
        </div>
    </div>

    @if (Model.RelatedServices.Any())
    {
        <div class="row">
            <div class="col-12 mb-3">
                <h4 class="fw-bold">Related Services</h4>
            </div>
            @foreach (var related in Model.RelatedServices)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@related.Thumbnail" class="card-img-top" alt="@related.Title" style="height: 180px; object-fit: cover;">
                        <div class="card-body">
                            <h6 class="card-title fw-bold">@related.Title</h6>
                            <p class="text-primary fw-bold mb-0">@related.SalePrice.ToString("N0") VND</p>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0">
                            <a asp-action="Details" asp-route-id="@related.Id" class="btn btn-sm btn-outline-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
