@page
@model CRUD_ChildrenCare.Pages.ServicePages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].BriefInfo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].OriginalPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].SalePrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].Thumbnail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].IsFeatured)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service[0].Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Service) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Category)
            </td>
            <td>
                @Html.DisplayFor(model => item.BriefInfo)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.OriginalPrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.SalePrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.Thumbnail)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsFeatured)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
