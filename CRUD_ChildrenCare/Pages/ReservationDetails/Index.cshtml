@page
@model CRUD_ChildrenCare.Pages.ReservationDetailPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ReservationDetail[0].ReservationId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReservationDetail[0].ServiceId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReservationDetail[0].Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReservationDetail[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReservationDetail[0].Service)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ReservationDetail) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ReservationId)
            </td>
            <td>
                @Html.DisplayFor(model => item.ServiceId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                @Html.DisplayFor(model => item.Service)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
