@page
@model CRUD_ChildrenCare.Pages.ReservationPages.IndexModel

@{
	ViewData["Title"] = "Reservations List";
}

<h1>Reservations Management</h1>
<p>
	<a asp-page="Create">Create New</a>
</p>


<!-- Lớp table-responsive giúp cuộn mượt mà nếu giao diện quá hẹp -->
<div class="table-responsive shadow-sm rounded-3">
	<table class="table table-hover align-middle mb-0">
		<thead class="table-light">
			<tr>
				<th>ID</th>
				<th>Customer</th>
				<th>Receiver Info</th>
				<th>Mobile</th>
				<th>Check-Up Time</th>
				<th>Total Cost</th>
				<th>Status</th>
				<th class="text-end">Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.Reservation)
			{
				<tr>
					<td class="fw-bold">#@item.Id</td>
					<td>Customer #@item.CustomerId</td>
					<td>
						<div class="fw-semibold">@item.ReceiverName</div>
						<small class="text-muted">@item.ReceiverEmail</small>
					</td>
					<td>@item.ReceiverMobile</td>
					<td>@item.CheckUpTime.ToString("yyyy-MM-dd HH:mm")</td>
					<td class="text-success fw-bold">@item.TotalCost.ToString("N0") VNĐ</td>
					<td>
						<span class="badge bg-info text-dark">@item.Status</span>
					</td>
					<td class="text-end text-nowrap">
						<a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">
							<i class="fa-solid fa-pen"></i> Edit
						</a>
						<a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
							<i class="fa-solid fa-eye"></i> Details
						</a>
						<a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
							<i class="fa-solid fa-trash"></i> Delete
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>